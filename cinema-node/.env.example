# =============================================
# APPLICATION
# =============================================
NODE_ENV=production
PORT=8000
FRONTEND_URL=https://your-domain.com

# =============================================
# DATABASE (mysql2/promise pool)
# =============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinema_db
DB_USER=your_db_user
DB_PASS=your_db_password

# =============================================
# JWT Authentication
# =============================================
JWT_SECRET=generate_a_random_secure_string_here
JWT_EXPIRES_IN=7d

# =============================================
# File Storage
# =============================================
UPLOAD_DIR=public/uploads

# =============================================
# VietQR Dynamic Payment QR
# Tra BIN code tại: https://api.vietqr.io/v2/banks
# =============================================
# Mặc định: VietinBank (970415)
VIETQR_BANK_BIN=970415
VIETQR_ACCOUNT_NUMBER=your_bank_account_number
VIETQR_ACCOUNT_NAME=YOUR_BANK_ACCOUNT_NAME
VIETQR_TEMPLATE=compact2
